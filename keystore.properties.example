# Copy this file to keystore.properties (which is git-ignored) and fill in your values.
# Never commit keystore.properties or the .jks file to version control.

# Path to the keystore file, relative to the project root.
storeFile=../multipong-release.jks

# Password set when the keystore was created (keytool -genkey ... -storepass)
storePassword=CHANGE_ME

# Alias chosen when the key was created (keytool -genkey ... -alias)
keyAlias=multipong

# Password for that key entry (keytool -genkey ... -keypass)
keyPassword=CHANGE_ME
